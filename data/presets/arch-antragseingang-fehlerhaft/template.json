{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Antragseingang der fiktiven Stadt Musterhausen: API Gateway -> Lambda (Eingang) -> SQS -> Lambda (Ablage) -> S3. Fiktives Beispiel.",
  "Resources": {
    "DataKey": {
      "Type": "AWS::KMS::Key",
      "Properties": {
        "Description": "Schluessel fuer Warteschlange, Antragsarchiv und Lambda-Umgebungsvariablen",
        "EnableKeyRotation": false,
        "KeyPolicy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "AccountAdmin",
              "Effect": "Allow",
              "Principal": {
                "AWS": {
                  "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:root"
                }
              },
              "Action": "kms:*",
              "Resource": "*"
            }
          ]
        }
      }
    },
    "ApiAccessLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/musterhausen/antragseingang/api-access",
        "RetentionInDays": 90,
        "KmsKeyId": {
          "Fn::GetAtt": [
            "DataKey",
            "Arn"
          ]
        }
      }
    },
    "IntakeLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/musterhausen/antragseingang/intake",
        "RetentionInDays": 90,
        "KmsKeyId": {
          "Fn::GetAtt": [
            "DataKey",
            "Arn"
          ]
        }
      }
    },
    "ArchiveLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/musterhausen/antragseingang/archive",
        "RetentionInDays": 90,
        "KmsKeyId": {
          "Fn::GetAtt": [
            "DataKey",
            "Arn"
          ]
        }
      }
    },
    "AntragsQueueDlq": {
      "Type": "AWS::SQS::Queue",
      "Properties": {
        "MessageRetentionPeriod": 1209600,
        "KmsMasterKeyId": {
          "Fn::GetAtt": [
            "DataKey",
            "Arn"
          ]
        }
      }
    },
    "AntragsQueue": {
      "Type": "AWS::SQS::Queue",
      "Properties": {
        "MessageRetentionPeriod": 345600,
        "VisibilityTimeout": 180,
        "KmsMasterKeyId": {
          "Fn::GetAtt": [
            "DataKey",
            "Arn"
          ]
        },
        "RedrivePolicy": {
          "deadLetterTargetArn": {
            "Fn::GetAtt": [
              "AntragsQueueDlq",
              "Arn"
            ]
          },
          "maxReceiveCount": 3
        }
      }
    },
    "AntragsArchiv": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "aws:kms",
                "KMSMasterKeyID": {
                  "Fn::GetAtt": [
                    "DataKey",
                    "Arn"
                  ]
                }
              },
              "BucketKeyEnabled": true
            }
          ]
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": false,
          "BlockPublicPolicy": false,
          "IgnorePublicAcls": false,
          "RestrictPublicBuckets": false
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "Loeschfrist-6-Jahre",
              "Status": "Enabled",
              "ExpirationInDays": 2557,
              "NoncurrentVersionExpiration": {
                "NoncurrentDays": 30
              }
            }
          ]
        }
      }
    },
    "IntakeRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "Logs",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "${IntakeLogs.Arn}:*"
                  }
                }
              ]
            }
          },
          {
            "PolicyName": "SendToQueue",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "sqs:SendMessage",
                  "Resource": {
                    "Fn::GetAtt": [
                      "AntragsQueue",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "kms:GenerateDataKey",
                    "kms:Decrypt"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "DataKey",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "ArchiveRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "Logs",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "${ArchiveLogs.Arn}:*"
                  }
                }
              ]
            }
          },
          {
            "PolicyName": "ConsumeAndStore",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "sqs:ReceiveMessage",
                    "sqs:DeleteMessage",
                    "sqs:GetQueueAttributes"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "AntragsQueue",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "s3:*",
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "kms:GenerateDataKey",
                    "kms:Decrypt"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "DataKey",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "IntakeFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "Description": "Formale Eingangspruefung, legt Antrag in die Warteschlange",
        "Runtime": "python3.13",
        "Handler": "index.handler",
        "Role": {
          "Fn::GetAtt": [
            "IntakeRole",
            "Arn"
          ]
        },
        "Timeout": 30,
        "MemorySize": 256,
        "LoggingConfig": {
          "LogGroup": {
            "Ref": "IntakeLogs"
          }
        },
        "Environment": {
          "Variables": {
            "QUEUE_URL": {
              "Ref": "AntragsQueue"
            }
          }
        },
        "KmsKeyArn": {
          "Fn::GetAtt": [
            "DataKey",
            "Arn"
          ]
        },
        "Code": {
          "ZipFile": "def handler(event, context):\n    # fiktiv: Schema pruefen, Vorgangsnummer vergeben, an SQS senden\n    return {'statusCode': 202}\n"
        }
      }
    },
    "ArchiveFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "Description": "Uebernimmt Antraege aus der Warteschlange in das Antragsarchiv",
        "Runtime": "python3.13",
        "Handler": "index.handler",
        "Role": {
          "Fn::GetAtt": [
            "ArchiveRole",
            "Arn"
          ]
        },
        "Timeout": 30,
        "MemorySize": 256,
        "LoggingConfig": {
          "LogGroup": {
            "Ref": "ArchiveLogs"
          }
        },
        "Environment": {
          "Variables": {
            "BUCKET_NAME": {
              "Ref": "AntragsArchiv"
            }
          }
        },
        "KmsKeyArn": {
          "Fn::GetAtt": [
            "DataKey",
            "Arn"
          ]
        },
        "Code": {
          "ZipFile": "def handler(event, context):\n    # fiktiv: Nachricht lesen, Antrag als Objekt in S3 ablegen\n    return None\n"
        }
      }
    },
    "ArchiveEventSource": {
      "Type": "AWS::Lambda::EventSourceMapping",
      "Properties": {
        "EventSourceArn": {
          "Fn::GetAtt": [
            "AntragsQueue",
            "Arn"
          ]
        },
        "FunctionName": {
          "Ref": "ArchiveFunction"
        },
        "BatchSize": 5
      }
    },
    "AntragsApi": {
      "Type": "AWS::ApiGateway::RestApi",
      "Properties": {
        "Name": "musterhausen-antragseingang",
        "EndpointConfiguration": {
          "Types": [
            "REGIONAL"
          ]
        }
      }
    },
    "AntraegeResource": {
      "Type": "AWS::ApiGateway::Resource",
      "Properties": {
        "RestApiId": {
          "Ref": "AntragsApi"
        },
        "ParentId": {
          "Fn::GetAtt": [
            "AntragsApi",
            "RootResourceId"
          ]
        },
        "PathPart": "antraege"
      }
    },
    "AntraegePost": {
      "Type": "AWS::ApiGateway::Method",
      "Properties": {
        "RestApiId": {
          "Ref": "AntragsApi"
        },
        "ResourceId": {
          "Ref": "AntraegeResource"
        },
        "HttpMethod": "POST",
        "AuthorizationType": "AWS_IAM",
        "Integration": {
          "Type": "AWS_PROXY",
          "IntegrationHttpMethod": "POST",
          "Uri": {
            "Fn::Sub": "arn:${AWS::Partition}:apigateway:${AWS::Region}:lambda:path/2015-03-31/functions/${IntakeFunction.Arn}/invocations"
          }
        }
      }
    },
    "ApiDeployment": {
      "Type": "AWS::ApiGateway::Deployment",
      "DependsOn": [
        "AntraegePost"
      ],
      "Properties": {
        "RestApiId": {
          "Ref": "AntragsApi"
        }
      }
    },
    "ApiStage": {
      "Type": "AWS::ApiGateway::Stage",
      "Properties": {
        "RestApiId": {
          "Ref": "AntragsApi"
        },
        "DeploymentId": {
          "Ref": "ApiDeployment"
        },
        "StageName": "v1",
        "AccessLogSetting": {
          "DestinationArn": {
            "Fn::GetAtt": [
              "ApiAccessLogs",
              "Arn"
            ]
          },
          "Format": "$context.requestId $context.identity.userArn $context.httpMethod $context.resourcePath $context.status"
        },
        "MethodSettings": [
          {
            "ResourcePath": "/*",
            "HttpMethod": "*",
            "LoggingLevel": "ERROR",
            "ThrottlingRateLimit": 50,
            "ThrottlingBurstLimit": 100
          }
        ]
      }
    },
    "ApiInvokePermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "Action": "lambda:InvokeFunction",
        "FunctionName": {
          "Ref": "IntakeFunction"
        },
        "Principal": "apigateway.amazonaws.com",
        "SourceArn": {
          "Fn::Sub": "arn:${AWS::Partition}:execute-api:${AWS::Region}:${AWS::AccountId}:${AntragsApi}/*/POST/antraege"
        }
      }
    }
  },
  "Outputs": {
    "ApiUrl": {
      "Value": {
        "Fn::Sub": "https://${AntragsApi}.execute-api.${AWS::Region}.amazonaws.com/v1"
      }
    }
  }
}
