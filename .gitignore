# Source files are downloaded by the build and verified by SHA-256 (ADR 0008)
data/intermediate/sources/

# CIS, FSBP and C5 full texts must not be redistributed (ADR 0008)
data/intermediate/extracted/cis.json
data/intermediate/extracted/fsbp.json
data/intermediate/extracted/c5.json
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/

# Preset design notes stay local: the blind cross-check must not see them (FAHRPLAN step 2)
data/input/presets/*.local.md

# Local secrets (Groq key for the build, ADR 0010) must never be committed
.env
